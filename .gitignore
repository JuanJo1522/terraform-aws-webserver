
# Terraform local directories
**/.terraform/*

# Local state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Local variable values
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!*.tfvars.json.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and credentials
.terraformrc
terraform.rc

# Sensitive local files
.env
.env.*
*.pem
*.key

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db
