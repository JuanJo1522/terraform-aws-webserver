
#!/bin/bash
set -euxo pipefail

dnf update -y

dnf install -y nginx

cat > /usr/share/nginx/html/index.html <<'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terraform AWS Web Server</title>
</head>
<body>
    <h1>${web_message}</h1>
</body>
</html>
EOF

systemctl enable nginx
systemctl start nginx
