
#!/bin/bash
set -eux

echo "User data execution started" > /var/log/webserver-test.log

mkdir -p /opt/webserver

cat > /opt/webserver/index.html <<'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Terraform Web Server</title>
</head>
<body>
    <h1>${web_message}</h1>
</body>
</html>
EOF

cd /opt/webserver

nohup python3 -m http.server 80 --bind 0.0.0.0 \
  > /var/log/python-webserver.log 2>&1 < /dev/null &

echo "User data execution completed" >> /var/log/webserver-test.log
